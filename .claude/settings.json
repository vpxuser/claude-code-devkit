{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash",
      "Bash(bash .claude/scripts/validate.sh*)",
      "Bash(jq *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.claude*)",
            "command": "bash .claude/scripts/validate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.claude*)",
            "command": "bash .claude/scripts/validate.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Welcome to Claude Code DevKit. This project helps you generate correct Claude Code configuration files (SKILL.md, Agent.md, .mcp.json, hooks.json, plugin.json, settings.json, commands, CLAUDE.md). Generated files are automatically validated after writing. Type /generate-file <type> to start, or describe what you need.\"}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
