{
  "$schema": "https://json.schemastore.org/claude-code-settings",

  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx markdownlint *)",
      "Bash(git *)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-write-check-placement.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-write-check-constraints.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check-limits.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
