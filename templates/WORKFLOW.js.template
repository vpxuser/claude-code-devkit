export const meta = {
  name: '[workflow-name]',
  description: '[One-line description shown in permission dialog]',
  phases: [
    { title: '[Phase 1]', detail: '[What this phase does]' },
    { title: '[Phase 2]', detail: '[What this phase does]' },
  ],
}

// Script body starts here
// Available globals: args, budget
// Available functions: agent(), parallel(), pipeline(), phase(), log()

phase('[Phase 1]')

const results = await pipeline(
  args.items,
  async (item) => {
    return await agent(`[Prompt for ${item}]`, {
      label: `[label]`,
      phase: '[Phase 1]',
    })
  }
)

phase('[Phase 2]')

const verified = await parallel(
  results.filter(Boolean).map(r => () =>
    agent(`Verify: ${r}`, {
      label: `verify:${r}`,
      phase: '[Phase 2]',
    })
  )
)

return { confirmed: verified.filter(Boolean) }
