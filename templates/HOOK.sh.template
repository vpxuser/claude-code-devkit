#!/bin/bash
# Hook: [NAME]
#
# Purpose: [一句话描述钩子用途]
# Event: [触发事件: PreToolUse, PostToolUse, Stop, etc.]
# Matcher: [匹配模式: tool name, file pattern, etc.]
#
# Input: JSON on stdin
# Output: JSON on stdout (optional)
# Exit codes:
#   0 - success (no decision)
#   1 - error
#   2 - decision (block/allow)

set -euo pipefail

INPUT=$(cat)

TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // empty')
TOOL_INPUT=$(echo "$INPUT" | jq -r '.tool_input // empty')

log() { echo "[HOOK] $1" >&2; }

decision() {
  local decision="$1"
  local reason="$2"
  jq -n --arg d "$decision" --arg r "$reason" '{
    hookSpecificOutput: {
      hookEventName: "[EVENT]",
      permissionDecision: $d,
      permissionDecisionReason: $r
    }
  }'
  exit 2
}

log "Hook triggered: $TOOL_NAME"

# TODO: Implement hook logic

# Example: block dangerous commands
if [[ "$TOOL_NAME" == "Bash" ]]; then
  COMMAND=$(echo "$TOOL_INPUT" | jq -r '.command // empty')
  if [[ "$COMMAND" == *"rm -rf"* ]]; then
    decision "deny" "Dangerous command blocked"
  fi
fi

exit 0
